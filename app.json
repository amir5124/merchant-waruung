{
  "expo": {
    "name": "Merchant Waruung",
    "slug": "merchant-waruung",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/merchant.png",
    "scheme": "merchantwaruung",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/merchant.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waruung.merchant"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/merchant.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.waruung.merchant",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/merchant.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan Merchant Waruung mengakses lokasi Anda."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/merchant_order.mp3"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Izinkan Merchant Waruung mengakses foto Anda.",
          "savePhotosPermission": "Izinkan Merchant Waruung menyimpan foto ke galeri Anda.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e948c5a-78a2-42d2-9d32-6754c1dcbf66"
      }
    },
    "owner": "amirku"
  }
}
